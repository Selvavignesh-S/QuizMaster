# QuizMaster Environment Configuration Example

SECRET_KEY=quizmaster_super_secret_key_2026

# Database Engine Selection ('sqlite' for local dev, 'postgres' for production)
DB_ENGINE=sqlite
SQLITE_PATH=quizmaster.db

# PostgreSQL Credentials (used when DB_ENGINE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quizmaster
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Application & Domain Settings
TEACHER_SUPERKEY=1
STUDENT_DOMAIN=@student.annauniv.edu
TEACHER_DOMAIN=@faculty.annauniv.edu

# Default Admin Account Seed Credentials
ADMIN_EMAIL=admin@annauniv.edu
ADMIN_PASSWORD=admin123
